name: Source checks

on:
  push:
    branches: [main, 'codex/**']
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: source-checks-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  retained-source:
    name: Manifest and focused retained source
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - name: Check out source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Verify complete source manifest
        shell: bash
        run: |
          python3 - <<'PY'
          from pathlib import Path
          import hashlib
          import re
          import subprocess

          root = Path.cwd()
          tracked = set(subprocess.check_output(['git', 'ls-files', '-z']).decode().split('\0')) - {''}
          expected = tracked - {'SOURCE_SHA256SUMS'}
          listed = set()
          for line in Path('SOURCE_SHA256SUMS').read_text().splitlines():
              digest, relative = line.split('  ', 1)
              assert re.fullmatch(r'[0-9a-f]{64}', digest), 'Invalid checksum'
              assert relative in expected and relative not in listed, 'Unexpected or duplicate manifest path'
              path = root / relative
              assert path.is_file() and not path.is_symlink(), 'Missing file or unexpected symlink'
              assert hashlib.sha256(path.read_bytes()).hexdigest() == digest, 'Checksum mismatch: ' + relative
              listed.add(relative)
          assert listed == expected, 'Manifest does not cover every tracked source file'
          print('Verified', len(listed), 'source files')
          PY
      - name: Use Node.js 24
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: '24'
          package-manager-cache: false
      - name: Install pinned npm dependencies
        run: npm ci
      - name: Check retained source
        run: |
          npm run build
          npm exec vitest -- run --dir src src/liminal-portrait.test.ts src/visual-growth.test.ts src/desktop-host.test.ts

  native-source:
    name: Native compile and domain contracts
    runs-on: macos-15
    timeout-minutes: 25
    steps:
      - name: Check out source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Report Swift toolchain
        run: swift --version
      - name: Compile native source
        run: swift build --package-path desktop
      - name: Check deterministic domain contracts
        run: >-
          swift test --package-path desktop
          --filter 'LiminalKnowledgeBindingsTests|KnowledgeGraphMeaningTests|KnowledgeMapMethodFlowTests|DocumentMethodEvidenceTests|WikiOSTaskExchangeTests'
      # No model/provider, window capture, GUI render, permission prompt, profile
      # migration, app launch or opt-in integration test is requested by this job.
